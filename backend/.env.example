# Copy to .env for local development. Never commit .env.
PRUFLO_ENV=local
PRUFLO_DATABASE_URL=postgresql+psycopg://pruflo:pruflo@localhost:5433/pruflo
PRUFLO_GCP_PROJECT=pruflo-local
PRUFLO_REGION=asia-southeast1
PRUFLO_EVIDENCE_BUCKET=pruflo-evidence-local
PRUFLO_PUBSUB_TOPIC=evidence-jobs
# Local only: accept "Bearer dev:<uid>:<email>" instead of a Firebase token.
PRUFLO_AUTH_DEV_MODE=true
PUBSUB_EMULATOR_HOST=localhost:8085
STORAGE_EMULATOR_HOST=http://localhost:4443
